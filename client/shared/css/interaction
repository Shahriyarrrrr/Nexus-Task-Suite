/* page transition wrappers */
.page-transition-enter {
  opacity:0;
  transform:translateY(8px) scale(0.998);
  transition:opacity 420ms cubic-bezier(.2,.9,.3,1), transform 420ms cubic-bezier(.2,.9,.3,1);
}
.page-transition-enter.page-transition-ready {
  opacity:1;
  transform:translateY(0) scale(1);
}
.page-transition-exit {
  opacity:1;
  transform:translateY(0) scale(1);
  transition:opacity 420ms cubic-bezier(.2,.9,.3,1), transform 420ms cubic-bezier(.2,.9,.3,1);
}
.page-transition-exit.page-transition-go {
  opacity:0;
  transform:translateY(-12px) scale(0.995);
}

/* parallax data attribute */
[data-parallax] {
  will-change:transform;
  transition:transform 0.12s linear;
}

/* magnetic buttons */
.magnetic {
  display:inline-block;
  position:relative;
  overflow:visible;
  transition:transform 0.18s cubic-bezier(.2,.9,.3,1);
  transform:translateZ(0);
}
.magnetic .magnetic-inner {
  display:block;
  transform:translate3d(0,0,0);
  transition:transform 0.18s cubic-bezier(.2,.9,.3,1);
}

/* neon cursor trail */
.cursor-trail {
  position:fixed;
  left:0;
  top:0;
  pointer-events:none;
  z-index:99999;
}
.cursor-dot {
  position:absolute;
  width:12px;
  height:12px;
  border-radius:50%;
  background:radial-gradient(circle at 40% 35%, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.65) 10%, rgba(108,92,231,0.45) 40%, rgba(0,206,201,0.12) 70%, transparent 100%);
  transform:translate(-50%,-50%) scale(0.9);
  opacity:0.95;
  transition:transform 220ms ease, opacity 420ms ease;
  mix-blend-mode:screen;
  will-change:transform, opacity;
  box-shadow:0 6px 20px rgba(108,92,231,0.18);
}

/* live search highlight */
.live-visible {
  display:block;
}
.live-hidden {
  display:none !important;
}

/* small helpers */
.centered {
  display:flex;
  align-items:center;
  justify-content:center;
}

/* parallax hero helper */
.hero-parallax {
  transform-style:preserve-3d;
  perspective:1200px;
}

/* subtle magnetic hover glow */
.magnetic:hover {
  filter:drop-shadow(0 10px 30px rgba(108,92,231,0.12));
}
